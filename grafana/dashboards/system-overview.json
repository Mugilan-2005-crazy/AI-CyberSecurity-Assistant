{
  "dashboard": {
    "id": null,
    "uid": "system-overview",
    "title": "System Overview",
    "description": "Enterprise system overview dashboard showing CPU, memory, disk, and uptime metrics",
    "tags": ["system", "overview", "infrastructure"],
    "timezone": "browser",
    "refresh": "15s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "CPU Usage",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [{ "expr": "cpu_usage_percent", "refId": "A", "legendFormat": "CPU Usage %" }],
        "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] } } }
      },
      {
        "id": 2,
        "title": "Memory Usage",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [{ "expr": "memory_heap_used_bytes / memory_heap_total_bytes * 100", "refId": "A", "legendFormat": "Memory Usage %" }],
        "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] } } }
      },
      {
        "id": 3,
        "title": "Disk Usage",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [{ "expr": "disk_usage_percent", "refId": "A", "legendFormat": "Disk Usage %" }],
        "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] } } }
      },
      {
        "id": 4,
        "title": "System Uptime",
        "type": "stat",
        "gridPos": { "h": 4, "w": 12, "x": 12, "y": 8 },
        "targets": [{ "expr": "system_uptime_seconds", "refId": "A", "legendFormat": "Uptime (seconds)" }],
        "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
      },
      {
        "id": 5,
        "title": "Load Average",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
        "targets": [
          { "expr": "cpu_load_average_1m", "refId": "A", "legendFormat": "1m" },
          { "expr": "cpu_load_average_5m", "refId": "B", "legendFormat": "5m" },
          { "expr": "cpu_load_average_15m", "refId": "C", "legendFormat": "15m" }
        ],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "id": 6,
        "title": "HTTP Requests Total",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
        "targets": [{ "expr": "http_requests_total", "refId": "A", "legendFormat": "Total Requests" }],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "id": 7,
        "title": "Active Socket Connections",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
        "targets": [{ "expr": "socket_connections", "refId": "A", "legendFormat": "Connections" }],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "id": 8,
        "title": "AI Requests",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
        "targets": [{ "expr": "ai_requests_total", "refId": "A", "legendFormat": "AI Requests" }],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "id": 9,
        "title": "Active Alerts",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
        "targets": [{ "expr": "alerts_active", "refId": "A", "legendFormat": "Active Alerts" }],
        "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" } } }
      },
      {
        "id": 10,
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
        "targets": [{ "expr": "error_total", "refId": "A", "legendFormat": "Total Errors" }],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "id": 11,
        "title": "Response Time Percentiles",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
        "targets": [
          { "expr": "performance_p50_ms", "refId": "A", "legendFormat": "P50" },
          { "expr": "performance_p95_ms", "refId": "B", "legendFormat": "P95" },
          { "expr": "performance_p99_ms", "refId": "C", "legendFormat": "P99" }
        ],
        "fieldConfig": { "defaults": { "unit": "ms" } }
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    }
  },
  "folderId": 0,
  "overwrite": false
}