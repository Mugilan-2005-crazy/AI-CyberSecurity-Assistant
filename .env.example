# ============================================================
# Enterprise Cyber Security Platform - Environment Template
# ============================================================
# Copy this file to .env and fill in values for your environment.
# Never commit .env files containing real secrets to version control.
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================

# ============================================================
# Application
# ============================================================
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# ============================================================
# Database
# ============================================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me_to_a_strong_password
MONGODB_URI=mongodb://admin:change_me_to_a_strong_password@mongodb:27017/cybersec?authSource=admin

# ============================================================
# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
JWT_SECRET=change_me_to_a_64_char_hex_secret
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change_me_to_a_different_64_char_hex_secret
JWT_REFRESH_EXPIRE=30d

# ============================================================
# Encryption key for TOTP MFA (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
ENCRYPTION_KEY=change_me_to_a_32_byte_hex_key

# ============================================================
# Client (for CORS)
# Development: http://localhost:5173
# Production: https://app.yourdomain.com
# ============================================================
CLIENT_ORIGIN=http://localhost:5173

# ============================================================
# Email (SMTP) — used for verification & password reset
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
EMAIL_FROM=Enterprise Cyber Security <no-reply@cybersec.io>

# ============================================================
# Google Gemini API
# ============================================================
GEMINI_API_KEY=your_gemini_api_key

# ============================================================
# Ollama Local AI
# Development: http://localhost:11434
# Production: http://ollama:11434 (Docker)
# ============================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=30000

# ============================================================
# VirusTotal API
# ============================================================
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# ============================================================
# Threat Intelligence Providers
# ============================================================
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
OTX_API_KEY=your_otx_api_key
NVD_API_KEY=your_nvd_api_key

# ============================================================
# Redis Cache
# Development: localhost
# Production: redis://redis:6379
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_to_a_strong_password
REDIS_TLS=false

# ============================================================
# OpenTelemetry / OTLP
# Development: http://localhost:4318
# Production: http://otel-collector:4318 (Docker)
# ============================================================
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ============================================================
# Admin bootstrap (created on first seed)
# ============================================================
ADMIN_EMAIL=admin@cybersec.io
ADMIN_PASSWORD=change_me_to_a_secure_password
ADMIN_NAME=Super Admin

# ============================================================
# Grafana
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_a_strong_password
