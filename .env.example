# ============================================================
# Application
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# Database
# ============================================================
MONGODB_URI=your_mongodb_connection_string

# ============================================================
# JWT
# ============================================================
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_REFRESH_EXPIRE=30d

# ============================================================
# Encryption Key (for MFA secrets, etc)
# ============================================================
ENCRYPTION_KEY=your_secure_encryption_key_min_32_chars

# ============================================================
# AI Providers
# ============================================================
GEMINI_API_KEY=your_gemini_api_key
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=30000

# ============================================================
# Email (SMTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
EMAIL_FROM=CyberSec Assistant <no-reply@yourdomain.com>

# ============================================================
# Admin Bootstrap
# ============================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# ============================================================
# Redis Cache
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=csa:
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3
REDIS_RETRY_BASE_DELAY_MS=100
REDIS_RETRY_MAX_DELAY_MS=5000

# ============================================================
# MFA / TOTP Configuration
# ============================================================
MFA_TOTP_WINDOW=1
MFA_BACKUP_CODES_COUNT=10
MFA_VERIFICATION_RATE_LIMIT=5
MFA_VERIFICATION_RATE_WINDOW=60000

# ============================================================
# OpenTelemetry (distributed tracing)
# ============================================================
OTEL_ENABLED=true
OTEL_SERVICE_NAME=cybersec-backend
OTEL_PROMETHEUS_PORT=9464
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
