{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/core/tauri-config-schema.json",
  "productName": "Enterprise Cyber Security Platform",
  "version": "2.1.1",
  "identifier": "com.cybersec.platform",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Enterprise Cyber Security Platform",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "url": "http://localhost:5173"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:5000 http://127.0.0.1:5000; img-src 'self' data: https: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-eval' 'unsafe-inline'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Enterprise Cyber Security",
    "copyright": "© 2025 Enterprise Cyber Security Platform",
    "license": "MIT",
    "shortDescription": "Enterprise AI Cyber Security Platform",
    "longDescription": "Enterprise AI Cyber Security Platform — AI-powered threat detection, incident response, and security operations.",
    "category": "Security",
    "windows": {
      "nsis": {
        "installMode": "perUser",
        "runAfterInstall": true,
        "languages": ["English"],
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {}
}