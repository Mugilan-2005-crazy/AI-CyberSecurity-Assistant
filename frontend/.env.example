# ============================================================
# Enterprise Cyber Security Platform - Frontend Environment
# ============================================================
# Copy this file to .env and fill in values for your environment.
# Never commit .env files containing real secrets to version control.
# ============================================================

# API base URL for the backend
# Development (uses Vite proxy): leave empty or set /api
# Production (served by nginx/Caddy): https://api.yourdomain.com
VITE_API_URL=/api

# Socket.IO server URL (for real-time features)
# Development: http://localhost:5000
# Production: https://api.yourdomain.com (or window.location.origin)
VITE_SOCKET_URL=http://localhost:5000
