# ============================================================
# Application
# ============================================================
NODE_ENV=production
PORT=5000
API_PREFIX=/api

# ============================================================
# MongoDB Atlas connection string
# For Docker Compose, use: mongodb://admin:admin123@mongodb:27017/cybersec?authSource=admin
# ============================================================
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/cybersec?retryWrites=true&w=majority

# ============================================================
# JWT (use a long random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRE=30d

# ============================================================
# Client (for CORS)
# In Docker, frontend is served via nginx on port 80
# Development: http://localhost:5173
# Production: https://app.yourdomain.com
# ============================================================
CLIENT_ORIGIN=http://localhost:5173

# ============================================================
# Email (SMTP) — used for verification & password reset
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=CyberSec Assistant <no-reply@yourdomain.com>

# ============================================================
# Google Gemini API
# ============================================================
GEMINI_API_KEY=your_gemini_api_key

# ============================================================
# VirusTotal API
# ============================================================
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# ============================================================
# Threat Intelligence Providers (Phase 2)
# ============================================================
ABUSEIPDB_API_KEY=your_abuseipdb_api_key
OTX_API_KEY=your_otx_api_key
NVD_API_KEY=your_nvd_api_key
THREAT_INTEL_CACHE_TTL=3600000
THREAT_INTEL_TIMEOUT=15000
THREAT_INTEL_MAX_RETRIES=3

# ============================================================
# Ollama Local AI
# Development: http://localhost:11434
# Production: http://ollama:11434 (Docker) or https://ollama.yourdomain.com
# ============================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=30000

# ============================================================
# Redis Cache
# Development: localhost
# Production: redis-cloud-url or redis://redis:6379
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ============================================================
# OpenTelemetry / OTLP
# Development: http://localhost:4318
# Production: https://otel-collector.yourdomain.com
# ============================================================
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ============================================================
# Admin bootstrap (created on first seed)
# ============================================================
ADMIN_EMAIL=admin@cybersec.io
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Super Admin
